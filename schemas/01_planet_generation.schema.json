{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanetGenDomain",
  "type": "object",
  "properties": {
    "deposit_affinities": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/DepositAffinityRecord"
      }
    },
    "fluids": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/FluidRecord"
      }
    },
    "geology_provinces": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/GeologyProvinceRecord"
      }
    },
    "hydrology_rules": {
      "anyOf": [
        {
          "$ref": "#/$defs/HydrologyRulesRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "planet_generation": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanetGenerationRecord"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "DepositAffinityRecord": {
      "type": "object",
      "properties": {
        "accessibility_tier": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "category_key": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "is_offshore": {
          "type": "boolean",
          "default": false
        },
        "max_purity_01": {
          "type": "number",
          "format": "float"
        },
        "max_tonnes": {
          "type": "number",
          "format": "double"
        },
        "min_purity_01": {
          "type": "number",
          "format": "float"
        },
        "min_tonnes": {
          "type": "number",
          "format": "double"
        },
        "province_id": {
          "type": "string"
        },
        "spawn_weight": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "province_id",
        "category_key",
        "accessibility_tier",
        "spawn_weight",
        "min_tonnes",
        "max_tonnes",
        "min_purity_01",
        "max_purity_01"
      ]
    },
    "FluidRecord": {
      "type": "object",
      "properties": {
        "boil_point_c": {
          "type": "number",
          "format": "float"
        },
        "density_kg_m3": {
          "type": "number",
          "format": "float"
        },
        "display_name": {
          "type": "string"
        },
        "freeze_point_c": {
          "type": "number",
          "format": "float"
        },
        "id": {
          "type": "string"
        },
        "latent_heat_evap_kj_kg": {
          "type": "number",
          "format": "float"
        },
        "specific_heat_j_kg_k": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "density_kg_m3",
        "freeze_point_c",
        "boil_point_c",
        "latent_heat_evap_kj_kg",
        "specific_heat_j_kg_k"
      ]
    },
    "GeologyProvinceRecord": {
      "type": "object",
      "properties": {
        "base_roughness_m": {
          "type": "number",
          "format": "float"
        },
        "display_name": {
          "type": "string"
        },
        "fault_instability_01": {
          "type": "number",
          "format": "float"
        },
        "id": {
          "type": "string"
        },
        "is_marine": {
          "type": "boolean"
        },
        "marine_upwelling_bias": {
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "soil_fertility_bias": {
          "type": "number",
          "format": "float"
        },
        "typical_age_myr": {
          "type": "number",
          "format": "float"
        },
        "volcanic_hazard_01": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "is_marine",
        "typical_age_myr",
        "base_roughness_m",
        "fault_instability_01",
        "volcanic_hazard_01",
        "soil_fertility_bias"
      ]
    },
    "HydrologyRulesRecord": {
      "type": "object",
      "properties": {
        "active_fluid_id": {
          "type": "string",
          "default": "water"
        },
        "aquifer_capacity_mm": {
          "type": "number",
          "format": "float",
          "default": 420.0
        },
        "aquifer_diffusivity": {
          "type": "number",
          "format": "float",
          "default": 0.08500000089406967
        },
        "dam_breach_flood_threshold_01": {
          "type": "number",
          "format": "float",
          "default": 0.9599999785423279
        },
        "dam_min_discharge_m3_s": {
          "type": "number",
          "format": "float",
          "default": 18.0
        },
        "dam_min_relief_m": {
          "type": "number",
          "format": "float",
          "default": 18.0
        },
        "dam_siltation_rate_per_day": {
          "type": "number",
          "format": "float",
          "default": 0.0001500000071246177
        },
        "dam_turbine_efficiency_01": {
          "type": "number",
          "format": "float",
          "default": 0.8199999928474426
        },
        "deep_navigable_min_q_m3_s": {
          "type": "number",
          "format": "float",
          "default": 45.0
        },
        "estuary_max_elev_m": {
          "type": "number",
          "format": "float",
          "default": 14.0
        },
        "evapotranspiration_scale": {
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "id": {
          "type": "string",
          "default": "default_hydrology_rules"
        },
        "infiltration_rate_01": {
          "type": "number",
          "format": "float",
          "default": 0.3400000035762787
        },
        "rapids_min_slope_rad": {
          "type": "number",
          "format": "float",
          "default": 0.03200000151991844
        },
        "shallow_ford_max_q_m3_s": {
          "type": "number",
          "format": "float",
          "default": 35.0
        },
        "spring_emergence_threshold_01": {
          "type": "number",
          "format": "float",
          "default": 0.8799999952316284
        }
      },
      "additionalProperties": false
    },
    "NaturalWorldBoundsRecord": {
      "type": "object",
      "properties": {
        "crop_count": {
          "type": "integer",
          "format": "uint16",
          "default": 5,
          "maximum": 65535,
          "minimum": 0
        },
        "crop_opt_temp_c_range": {
          "type": "array",
          "default": [
            8.0,
            30.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "fauna_count": {
          "type": "integer",
          "format": "uint16",
          "default": 4,
          "maximum": 65535,
          "minimum": 0
        },
        "flux_count": {
          "type": "integer",
          "format": "uint16",
          "default": 3,
          "maximum": 65535,
          "minimum": 0
        },
        "fuel_count": {
          "type": "integer",
          "format": "uint16",
          "default": 4,
          "maximum": 65535,
          "minimum": 0
        },
        "fuel_enthalpy_mj_kg_range": {
          "type": "array",
          "default": [
            14.0,
            44.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "ore_count": {
          "type": "integer",
          "format": "uint16",
          "default": 6,
          "maximum": 65535,
          "minimum": 0
        },
        "ore_melting_k_range": {
          "type": "array",
          "default": [
            1150.0,
            1850.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "ore_purity_range": {
          "type": "array",
          "default": [
            0.18000000715255737,
            0.7200000286102295
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "pathogen_count": {
          "type": "integer",
          "format": "uint16",
          "default": 3,
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "PlanetGenerationRecord": {
      "type": "object",
      "properties": {
        "axial_tilt_deg": {
          "type": "number",
          "format": "float"
        },
        "base_sea_level_m": {
          "type": "number",
          "format": "float"
        },
        "goldberg_subdivision": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "land_fraction_target": {
          "type": "number",
          "format": "float"
        },
        "max_orogenic_uplift_m": {
          "type": "number",
          "format": "float"
        },
        "mean_radius_km": {
          "type": "number",
          "format": "float"
        },
        "natural_bounds": {
          "$ref": "#/$defs/NaturalWorldBoundsRecord",
          "default": {
            "crop_count": 5,
            "crop_opt_temp_c_range": [
              8.0,
              30.0
            ],
            "fauna_count": 4,
            "flux_count": 3,
            "fuel_count": 4,
            "fuel_enthalpy_mj_kg_range": [
              14.0,
              44.0
            ],
            "ore_count": 6,
            "ore_melting_k_range": [
              1150.0,
              1850.0
            ],
            "ore_purity_range": [
              0.18000000715255737,
              0.7200000286102295
            ],
            "pathogen_count": 3
          }
        },
        "planetary_density_kg_m3": {
          "type": "number",
          "format": "float"
        },
        "rotation_period_hours": {
          "type": "number",
          "format": "float"
        },
        "solar_constant_w_m2": {
          "type": "number",
          "format": "float"
        },
        "tectonic_plate_count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "goldberg_subdivision",
        "tectonic_plate_count",
        "land_fraction_target",
        "axial_tilt_deg",
        "solar_constant_w_m2",
        "rotation_period_hours",
        "mean_radius_km",
        "base_sea_level_m",
        "max_orogenic_uplift_m",
        "planetary_density_kg_m3"
      ]
    }
  }
}
