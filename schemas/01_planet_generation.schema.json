{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanetGenDomain",
  "type": "object",
  "properties": {
    "planet_generation": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanetGenerationRecord"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "NaturalWorldBoundsRecord": {
      "type": "object",
      "properties": {
        "crop_count": {
          "type": "integer",
          "format": "uint16",
          "default": 5,
          "maximum": 65535,
          "minimum": 0
        },
        "crop_opt_temp_c_range": {
          "type": "array",
          "default": [
            8.0,
            30.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "fauna_count": {
          "type": "integer",
          "format": "uint16",
          "default": 4,
          "maximum": 65535,
          "minimum": 0
        },
        "flux_count": {
          "type": "integer",
          "format": "uint16",
          "default": 3,
          "maximum": 65535,
          "minimum": 0
        },
        "fuel_count": {
          "type": "integer",
          "format": "uint16",
          "default": 4,
          "maximum": 65535,
          "minimum": 0
        },
        "fuel_enthalpy_mj_kg_range": {
          "type": "array",
          "default": [
            14.0,
            44.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "ore_count": {
          "type": "integer",
          "format": "uint16",
          "default": 6,
          "maximum": 65535,
          "minimum": 0
        },
        "ore_melting_k_range": {
          "type": "array",
          "default": [
            1150.0,
            1850.0
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "ore_purity_range": {
          "type": "array",
          "default": [
            0.18000000715255737,
            0.7200000286102295
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "pathogen_count": {
          "type": "integer",
          "format": "uint16",
          "default": 3,
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "PlanetGenerationRecord": {
      "type": "object",
      "properties": {
        "axial_tilt_deg": {
          "type": "number",
          "format": "float"
        },
        "base_sea_level_m": {
          "type": "number",
          "format": "float"
        },
        "goldberg_subdivision": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "land_fraction_target": {
          "type": "number",
          "format": "float"
        },
        "max_orogenic_uplift_m": {
          "type": "number",
          "format": "float"
        },
        "mean_radius_km": {
          "type": "number",
          "format": "float"
        },
        "natural_bounds": {
          "$ref": "#/$defs/NaturalWorldBoundsRecord",
          "default": {
            "crop_count": 5,
            "crop_opt_temp_c_range": [
              8.0,
              30.0
            ],
            "fauna_count": 4,
            "flux_count": 3,
            "fuel_count": 4,
            "fuel_enthalpy_mj_kg_range": [
              14.0,
              44.0
            ],
            "ore_count": 6,
            "ore_melting_k_range": [
              1150.0,
              1850.0
            ],
            "ore_purity_range": [
              0.18000000715255737,
              0.7200000286102295
            ],
            "pathogen_count": 3
          }
        },
        "planetary_density_kg_m3": {
          "type": "number",
          "format": "float"
        },
        "rotation_period_hours": {
          "type": "number",
          "format": "float"
        },
        "solar_constant_w_m2": {
          "type": "number",
          "format": "float"
        },
        "tectonic_plate_count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "goldberg_subdivision",
        "tectonic_plate_count",
        "land_fraction_target",
        "axial_tilt_deg",
        "solar_constant_w_m2",
        "rotation_period_hours",
        "mean_radius_km",
        "base_sea_level_m",
        "max_orogenic_uplift_m",
        "planetary_density_kg_m3"
      ]
    }
  }
}
