{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcessesDomain",
  "type": "object",
  "properties": {
    "processes": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ProcessRecord"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ProcessQuantityRecord": {
      "type": "object",
      "properties": {
        "amount_kg": {
          "type": "number",
          "format": "double"
        },
        "commodity": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "commodity",
        "amount_kg"
      ]
    },
    "ProcessRecord": {
      "type": "object",
      "properties": {
        "cycle_hours": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "display_name": {
          "type": "string"
        },
        "fallback_tool_commodity": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ProcessQuantityRecord"
          }
        },
        "is_crop_cultivation": {
          "type": "boolean",
          "default": false
        },
        "is_mine_drainage": {
          "type": "boolean",
          "default": false
        },
        "is_outdoor_construction": {
          "type": "boolean",
          "default": false
        },
        "is_underground_mine": {
          "type": "boolean",
          "default": false
        },
        "max_temp_c": {
          "type": "number",
          "format": "float",
          "default": 50.0
        },
        "min_temp_c": {
          "type": "number",
          "format": "float",
          "default": -40.0
        },
        "optimal_moisture_01": {
          "type": "number",
          "format": "float",
          "default": 0.44999998807907104
        },
        "outputs": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ProcessQuantityRecord"
          }
        },
        "required_vocation": {
          "type": "string"
        },
        "tool_commodity": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "tool_wear_intensity": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "waste_commodity": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "weather_halt_mud_threshold": {
          "type": "number",
          "format": "float"
        },
        "workforce_hours_required": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "required_vocation",
        "cycle_hours",
        "workforce_hours_required",
        "weather_halt_mud_threshold"
      ]
    }
  }
}
